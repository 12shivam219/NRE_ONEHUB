# ⚠️  SECURITY NOTICE ⚠️
# This is a TEMPLATE file. DO NOT store real credentials here.
# Copy this to .env and fill with actual values locally.
# .env is in .gitignore and should NEVER be committed to git.
#
# If credentials are ever exposed in git history:
# 1. Immediately revoke the compromised credentials
# 2. Generate new ones
# 3. Use git-filter-branch or BFG to remove from history
# 4. Force push (only if safe to do so)

# Groq API Key (Free - https://console.groq.com/keys)
# Get your free API key from: https://console.groq.com/keys
# No credit card required, no quota limits
GROQ_API_KEY=your_actual_groq_api_key_here

# Neon PostgreSQL Database URL
# Format: postgresql://username:password@host/database?params
# Get from: https://console.neon.tech
# Required for resume storage features
DATABASE_URL=postgresql://your_username:your_password@your_host/your_database?sslmode=require

# Optional: Google Drive API Credentials
# Only needed if using Google Drive storage
# Get from: https://console.cloud.google.com
# GOOGLE_CREDENTIALS_FILE=credentials.json

# --- Production API hardening (required when ENVIRONMENT=production) ---
# ENVIRONMENT=development
# CORS_ORIGINS=https://app.example.com,http://localhost:5173
# API_URL=http://localhost:8000
# Public URL the ONLYOFFICE Document Server can POST to (often your API load balancer URL)
# ONLYOFFICE_CALLBACK_PUBLIC_URL=https://api.example.com
# ONLYOFFICE_DOCUMENT_SERVER_URL=https://onlyoffice.example.com
# ONLYOFFICE_CALLBACK_SECRET=use_a_long_random_string_min_32_chars
# SUPABASE_JWT_SECRET=from_supabase_dashboard_settings_api_jwt_secret
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service_role_key_server_only
# Optional local dev only if you intentionally skip signed ONLYOFFICE callbacks:
# ALLOW_INSECURE_ONLYOFFICE_CALLBACK=1

# Optional shared secret for CPU/GPU-heavy anonymous routes (process-text, batch, Groq, export, email, …).
# When set, clients must send header X-Text-Processor-Api-Key (or X-API-Key) with the same value.
# Prefer terminating TLS at a reverse proxy and injecting that header instead of baking into the SPA bundle.
# TEXT_PROCESSOR_API_KEY=

# ONLYOFFICE callback URL tuning (see resolve_onlyoffice_callback_public_base in api_server/auth_utils.py):
# ONLYOFFICE_CALLBACK_PUBLIC_URL=https://api.example.com   # best: explicit URL Document Server can reach
# USE_FORWARDED_URL_FOR_ONLYOFFICE_CALLBACK=1             # only behind a trusted proxy; uses X-Forwarded-* Host
