# Text processor / FastAPI backend
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends gcc libpq-dev \
  && rm -rf /var/lib/apt/lists/*

COPY Backend/api_server/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY Backend/ /app/

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Render and other hosts inject PORT; default 8000 for local docker compose.
EXPOSE 8000

CMD ["sh", "-c", "uvicorn api_server.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers --forwarded-allow-ips \"*\""]
