# Vite React frontend → static nginx
FROM node:20-alpine AS build

WORKDIR /app

COPY Frontend/package.json Frontend/package-lock.json* ./
RUN npm ci

COPY Frontend/ ./

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_API_URL
ARG VITE_TEXT_PROCESSOR_API_URL
ARG VITE_TEXT_PROCESSOR_API_KEY

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_TEXT_PROCESSOR_API_URL=$VITE_TEXT_PROCESSOR_API_URL
ENV VITE_TEXT_PROCESSOR_API_KEY=$VITE_TEXT_PROCESSOR_API_KEY

RUN npm run build

FROM nginx:1.27-alpine

COPY docker/nginx.default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
